{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(pnpm test)",
      "Bash(pnpm test:*)",
      "Bash(pnpm run test)",
      "Bash(pnpm run test:*)",
      "Bash(npm test)",
      "Bash(npm run test*)",
      "Bash(yarn test*)",
      "Bash(vitest*)",
      "Bash(npx vitest*)",
      "Bash(playwright*)",
      "Bash(npx playwright*)",
      "Bash(pnpm exec playwright*)",
      "Bash(pnpm build)",
      "Bash(pnpm run build)",
      "Bash(npm run build)",
      "Bash(yarn build)",
      "Bash(next build*)",
      "Bash(npx next build*)",
      "Bash(pnpm start)",
      "Bash(pnpm dev)",
      "Bash(pnpm run dev)",
      "Bash(npm run dev)",
      "Bash(yarn dev)",
      "Bash(next dev*)",
      "Bash(npx next dev*)",
      "Bash(pnpm lint)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm run lint*)",
      "Bash(npm run lint*)",
      "Bash(next lint*)",
      "Bash(eslint*)",
      "Bash(npx eslint*)",
      "Bash(pnpm format)",
      "Bash(pnpm format:*)",
      "Bash(pnpm run format*)",
      "Bash(prettier*)",
      "Bash(npx prettier*)",
      "Bash(tsc*)",
      "Bash(npx tsc*)",
      "Bash(pnpm tsc*)",
      "Bash(pnpm exec tsc*)",
      "Bash(pnpm db:types)",
      "Bash(pnpm run db:types)",
      "Bash(supabase start*)",
      "Bash(supabase stop*)",
      "Bash(supabase db reset*)",
      "Bash(supabase db push*)",
      "Read(./types/supabase.ts)",
      "Read(./pnpm-lock.yaml)",
      "Read(./package-lock.json)",
      "Read(./yarn.lock)",
      "Read(./messages/fr.json)",
      "Read(./messages/de.json)",
      "Read(./messages/es.json)",
      "Read(./coverage/**)",
      "Read(./.next/**)",
      "Read(./node_modules/**)",
      "Read(./playwright-report/**)",
      "Read(./test-results/**)",
      "Bash(cat ./types/supabase.ts*)",
      "Bash(cat ./pnpm-lock.yaml*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets/**)"
    ],
    "allow": ["Bash(find *)", "Bash(grep *)", "Read(./messages/*)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/wrap-reminder.sh"
          }
        ]
      }
    ]
  }
}
